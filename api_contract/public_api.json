          "kind": "exception",
          "methods": [
            "__init__"
          ]
        },
        "ILinalgOptAdapter": {
          "kind": "class",
          "track_added_abstract_methods": true
        },
        "ILinalgPybindAdapter": {
          "kind": "class",
          "track_added_abstract_methods": true
        },
        "ITritonToLinalgAdapter": {
          "kind": "class",
          "methods": [
            "convert",
            "get_output_dialects",
            "get_required_passes",
