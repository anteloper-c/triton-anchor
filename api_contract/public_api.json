        "AnchorIRValidator",
        "ComputeParadigm",
        "HWCapability",
        "build_ttir_pipeline"
      ]
    },
    "triton_anchor.hw_capability": {
      "classes": {
        "ComputeParadigm": {
          "kind": "enum"
        },
        "GPGPUCapability": {
          "kind": "dataclass"
        },
        "HWCapability": {
          "kind": "dataclass",
          "methods": [
            "lowering_path",
            "to_gpu_target",
            "validate"
          ]
        },
        "MatrixCapability": {
          "kind": "dataclass"
        },
        "TensorCapability": {
          "kind": "dataclass"
        }
      }
    },
    "triton_anchor.anchor_ir": {
      "classes": {
        "AnchorIRError": {
          "kind": "exception"
        },
        "AnchorIRTrack": {
          "kind": "enum"
        },
        "AnchorIRValidator": {
          "kind": "class",
          "methods": [
            "__init__",
            "is_valid",
            "validate",
            "validate_and_raise",
            "validate_post_hook",
            "validate_pre_hook"
          ]
        },
        "AnchorIRViolation": {
          "kind": "dataclass"
        }
      }
    },
    "triton_anchor.pipeline": {
      "functions": [
