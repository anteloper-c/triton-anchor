        }
      }
    },
    "triton_anchor.adapters.registry": {
      "classes": {
        "AdapterNotFoundError": {
          "kind": "exception"
        },
        "AdapterRegistry": {
          "kind": "class",
          "methods": [
            "discover",
            "get",
