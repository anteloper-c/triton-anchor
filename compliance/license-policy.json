{
  "schema_version": 1,
  "status": "pending",
  "approval_required": "leader-and-license-reviewer",
  "expression_matching": "exact-spdx-expression",
  "expressions": {
    "Apache-2.0": {
      "decision": "allow"
    },
    "MIT": {
      "decision": "allow"
    },
    "BSD-3-Clause": {
      "decision": "allow"
    },
    "Apache-2.0 WITH LLVM-exception": {
      "decision": "allow"
    },
    "Python-2.0": {
      "decision": "allow"
    },
    "Zlib": {
      "decision": "allow"
    },
    "AGPL-3.0-only": {
      "decision": "deny"
    },
    "AGPL-3.0-or-later": {
      "decision": "deny"
