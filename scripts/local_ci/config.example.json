        ],
        "env": {}
      }
    },
    {
      "id": "triton-3.6",
      "triton_version": "3.6",
      "llvm_revision": "a992f29451b9e140424f35ac5e20177db4afbdc0",
      "seed_venv": "/opt/ci-venv",
      "agent_user": "1001:1000",
      "dependency_sources": {},
      "container": {
        "name": "anchor-ci-triton-3-6",
        "image": "anchor-ci/triton-3.6:maintained",
        "run_args": [
          "--add-host",
          "host.docker.internal:host-gateway",
          "--mount",
          "type=bind,src=/opt/anchor-ci/scripts/local_ci,dst=/opt/anchor-ci,readonly",
          "--mount",
          "type=bind,src=/srv/anchor-ci/workspace,dst=/workspace"
        ],
        "healthcheck": [
          "sh",
          "-c",
          "test -x /opt/llvm/bin/mlir-opt && test -s /opt/llvm/anchor-ci-llvm-revision && /opt/ci-venv/bin/python -c 'import build, pytest, jsonschema, yaml' && codex --version"
        ]
      },
      "maintenance": {
        "window_start": "18:00",
        "window_minutes": 180,
        "stagger_minutes": 90,
        "disk_path": "/var/lib/docker",
        "min_free_gb": 40,
        "build_timeout_seconds": 14400,
        "recipe": {
          "context": "/etc/anchor-ci/recipes/triton-3.6",
          "dockerfile": "Dockerfile.worker",
          "build_args": {
            "BASE_IMAGE": "REPLACE_WITH_TRUSTED_IMAGE_AT_SHA256_DIGEST",
            "CODEX_VERSION": "REPLACE_WITH_VERIFIED_VERSION",
            "LLVM_BUILD_JOBS": "4"
          }
        }
      },
      "tools": {
        "python_bin": "/opt/ci-venv/bin/python",
        "llvm_dir": "/opt/llvm",
        "required_modules": [
          "build",
          "setuptools",
          "wheel",
          "pybind11"
        ],
        "required_commands": [
          "git",
          "cmake",
          "ninja"
        ],
        "env": {}
      }
    }
  ],
  "health": {
    "publish": true,
    "poller_max_age_seconds": 180,
    "task_heartbeat_max_age_seconds": 300,
    "task_max_age_seconds": 14400,
    "min_free_gb": 20,
    "disk_paths": [
      "/var/lib/anchor-ci",
      "/srv/anchor-ci/workspace",
      "/var/lib/docker"
    ],
    "systemd_services": [
      "anchor-ci-poller.service"
    ]
  },
  "smtp": {
    "accounts": [
      "heron-mc",
      "likehupochuan"
    ],
    "account_emails": {
      "heron-mc": "",
      "likehupochuan": ""
    },
    "host": "",
    "from": "",
    "port": 587,
    "starttls": true,
    "username_env": "LOCAL_CI_SMTP_USERNAME",
    "password_env": "LOCAL_CI_SMTP_PASSWORD"
  }
}
