      "maintenance": {
        "window_start": "18:00",
        "window_minutes": 180,
        "stagger_minutes": 45,
        "disk_path": "/var/lib/docker",
        "min_free_gb": 40,
        "build_timeout_seconds": 14400,
        "recipe": {
          "context": "/etc/anchor-ci/recipes/triton-3.3",
          "dockerfile": "Dockerfile.worker",
          "build_args": {
            "BASE_IMAGE": "REPLACE_WITH_TRUSTED_IMAGE_AT_SHA256_DIGEST",
            "CODEX_VERSION": "REPLACE_WITH_VERIFIED_VERSION",
            "LLVM_BUILD_JOBS": "4"
          }
        }
      },
      "tools": {
        "python_bin": "/opt/ci-venv/bin/python",
        "llvm_dir": "/opt/llvm",
        "required_modules": [
          "build",
