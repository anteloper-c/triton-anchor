[Unit]
Description=Expire Local CI result evidence by upload age

[Service]
Type=oneshot
EnvironmentFile=/etc/triton-anchor-local-ci/credentials.env
WorkingDirectory=/opt/local-ci/control/triton-anchor
UMask=0077
NoNewPrivileges=yes
Environment="DOCKER_HOST="
UnsetEnvironment=DOCKER_CONTEXT DOCKER_TLS_VERIFY DOCKER_CERT_PATH
ExecStart="/usr/bin/python3" "/opt/local-ci/control/triton-anchor/scripts/local_ci/ops_maint/retention.py" --config "/etc/triton-anchor-local-ci/config.json" --apply
TimeoutStartSec=1h
