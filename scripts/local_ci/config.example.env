# Copy this file to /opt/local-ci/config.env on the local server and edit it.

# Gitee CI relay repository. It stores task code on ci/* and results on local-ci-results.
GITEE_REPO_URL="https://gitee.com/likehupochuan/triton-anchor-local-ci-results.git"
GITEE_OWNER="likehupochuan"
GITEE_REPO="triton-anchor-local-ci-results"
GITEE_BRANCH="ci/push/jiwang-delivery-ci"
# GitHub dispatch writes push tasks to ci/push/*, PR head tasks to
# ci/pr-<pr-number>/<source-branch>, PR base pointers to ci/base/pr-*, and
# manual full FlagGems tasks to ci/full/*. The poller runs push/head/full
# tasks; base pointers are consumed only for performance baselines.
# Discover all refs in this relay repository, then accept only those task refs.
GITEE_BRANCHES="ci/push/jiwang-delivery-ci"
GITEE_POLL_ALL_BRANCHES="1"
# Applied after branch discovery. The local-ci-results branch is never selected.
GITEE_BRANCH_INCLUDE_REGEX="^ci/(pr-[0-9]+/.+|push/.+|full/.+)$"

# Optional token used to read the private relay, push results, and create commit comments.
# Keep the real token in config.env or the shell environment, not in git.
GITEE_TOKEN=""
GITEE_USERNAME="likehupochuan"
# Optional credentials forwarded into Docker only for fetching the ci/* task ref.
# Prefer a read-only relay token here; leave empty when the relay repository is public/readable.
LOCAL_CI_CONTAINER_GITEE_USERNAME="likehupochuan"
LOCAL_CI_CONTAINER_GITEE_TOKEN=""
# Backward-compatibility escape hatch. Keep 0 when running automatic fork PR code.
LOCAL_CI_ALLOW_WRITE_TOKEN_IN_CONTAINER="0"
GITEE_RESULT_CONTEXT="local-ci/sophgo-cmodel"

# Results use a dedicated branch in the same relay repository as the ci/* task refs.
GITEE_RESULTS_OWNER="likehupochuan"
GITEE_RESULTS_REPO="triton-anchor-local-ci-results"
GITEE_RESULTS_REPO_URL="https://gitee.com/likehupochuan/triton-anchor-local-ci-results.git"
GITEE_RESULTS_BRANCH="local-ci-results"
GITEE_RESULTS_WEB_URL="https://gitee.com/likehupochuan/triton-anchor-local-ci-results"
PUBLISH_GITEE_RESULTS="1"
GITEE_WEB_URL="https://gitee.com/likehupochuan/triton-anchor-local-ci-results"

# Host-side runner settings.
LOCAL_CI_CONTAINER="anchor-sophgo-ci"
LOCAL_CI_STATE_DIR="/home/race_work/local_ci/local-ci-state"
LOCAL_CI_SCRIPT_DIR="/home/race_work/local_ci/control_anchor/triton-anchor/scripts/local_ci"
LOCAL_CI_POLL_INTERVAL="60"
LOCAL_CI_WORKSPACE_HOST="/home/race_work/local_ci/workspace"

# Container-side workspace. ANCHOR_DIR is deleted and freshly cloned for every
# task; backend/LLVM/PPL/FlagGems remain prepared and must not overlap it.
WORKSPACE="/workspace"
ANCHOR_DIR="/workspace/triton-anchor"
LLVM_BUILD_DIR="/workspace/llvm-release"
PPL_ROOT="/workspace/ppl-release"
LOCAL_CI_ARTIFACT_ROOT="/workspace/local-ci-artifacts"

# Backend profile. For another backend, change these paths/commands only.
BACKEND_PROFILE="sophgo-cmodel"
EXPECTED_TRITON_BACKEND="sophgo"
BACKEND_PATH="/workspace/triton-sophgo-backend"
BACKEND_ENVSETUP="envsetup.sh"
BACKEND_ENVSETUP_ARGS="PIO_CMODEL"
BACKEND_TEST_COMMAND="python3 tests/test_smoke.py && python3 tests/test_jit.py"

# FlagGems defaults to a regular sample: select one passing op from each of the 8 categories.
# The current whitelist contains 59 ops from the 2026-07-23 full run.
# Manual full runs are dispatched through ci/full/* with FLAGGEMS_TEST_MODE=full and use attachment-5 ops 1-127.
# Set FLAGGEMS_TEST_COMMAND to bypass the selector completely.
RUN_FLAGGEMS_TESTS="true"
FLAGGEMS_CLONE_DIR="/workspace/FlagGems"
FLAGGEMS_REF=""
FLAGGEMS_PIP_PACKAGES="scipy pytest"
FLAGGEMS_TEST_MODE="sample"
FLAGGEMS_SAMPLE_SIZE="8"
FLAGGEMS_RANDOM_SEED=""
FLAGGEMS_TEST_OP="abs"
FLAGGEMS_TEST_COMMAND=""
# The batch runner keeps each operator in a separate process and preserves the
# historical five-column Chinese CSV summary format.
FLAGGEMS_PYTEST_ARGS="--ref cpu -vs"
FLAGGEMS_IDLE_TIMEOUT_SECONDS="300"
FLAGGEMS_TOTAL_TIMEOUT_SECONDS="6000"
# Full mode treats TOTAL as a soft deadline. It extends only when new pytest
# nodes completed since the previous deadline, and never exceeds HARD.
FLAGGEMS_FULL_TIMEOUT_EXTENSION_SECONDS="1800"
FLAGGEMS_FULL_HARD_TIMEOUT_SECONDS="14400"
FLAGGEMS_CLEAR_CACHE="1"
FLAGGEMS_WHITELIST=""
FLAGGEMS_FULL_LIST=""
INSTALL_FLAGGEMS_PACKAGES="1"
#
# Build controls. The active venv's existing triton-anchor distribution is
# uninstalled before each clean source build. Leave FRONTEND_BUILD_COMMAND empty
# to auto-select uv or python -m build.
PACKAGE_TOOL="auto"
PYTHON_BIN="python3"
PYTHON_VENV_ACTIVATE="/opt/venv/bin/activate"
SOURCE_ENVSETUP="1"
FRONTEND_BUILD_COMMAND=""

# Compile-time regression. PR tasks compare these four kernels against the
# cached result for the PR base SHA. A missing baseline is measured once.
RUN_COMPILE_BENCHMARK="true"
COMPILE_BENCHMARK_KERNELS="add,mm,softmax,layernorm"
COMPILE_BENCHMARK_REPEAT="5"
COMPILE_BENCHMARK_WARMUP="1"
COMPILE_BENCHMARK_THRESHOLD="0.20"
COMPILE_BENCHMARK_TIMEOUT="30m"

# Pass-level profiling regression. This uses TRITON_ANCHOR_PROFILE=1 and runs
# separately from the end-to-end compile benchmark so timing diagnostics do not
# distort compile-time measurements.
RUN_PASS_PROFILE="true"
PASS_PROFILE_KERNELS="add,mm,softmax,layernorm"
PASS_PROFILE_REPEAT="3"
PASS_PROFILE_WARMUP="1"
PASS_PROFILE_THRESHOLD="0.20"
PASS_PROFILE_MIN_BASE_MS="1.0"
PASS_PROFILE_MIN_DELTA_MS="1.0"
PASS_PROFILE_TIMEOUT="30m"

# TTIR serialization/deserialization regression. The benchmark compiles each
# kernel once to obtain real TTIR cache files, then times text conversion and
# file-based MLIR parsing independently from normal kernel compilation.
RUN_IR_SERIALIZATION_BENCHMARK="true"
IR_SERIALIZATION_KERNELS="add,mm,softmax,layernorm"
IR_SERIALIZATION_REPEAT="20"
IR_SERIALIZATION_WARMUP="3"
IR_SERIALIZATION_METRICS="serialize,deserialize"
IR_SERIALIZATION_THRESHOLD="0.20"
IR_SERIALIZATION_MIN_BASE_MS="0.05"
IR_SERIALIZATION_MIN_DELTA_MS="0.05"
IR_SERIALIZATION_TIMEOUT="30m"

# Keep source/backend rebuilds within the server's resource limit.
MAX_JOBS="1"
CMAKE_BUILD_PARALLEL_LEVEL="1"
NINJAFLAGS="-j1"
UV_LINK_MODE="copy"
