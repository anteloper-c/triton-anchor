# Local CI v4 uses a private server-owned JSON configuration. This is an example
# systemd EnvironmentFile. Do not overwrite existing server/model configuration.
# Fill actual values in deploy/config.example.json; missing values fail preflight.
LOCAL_CI_CONFIG="/etc/triton-anchor-local-ci/config.json"

# Reuse the existing dedicated company config.toml/auth.json and actual model.
# The JSON codex_home field takes precedence. No model/API values are invented.
CODEX_AI_CI_HOME=""

# Host-only relay/result credentials; never place these in candidate profile env.
GITEE_TOKEN=""
GITEE_USERNAME=""
GITEE_HEALTH_TOKEN=""

# Also configure these on the external watchdog host. Simulation uses .eml
# outbox files and never sends a real message.
LOCAL_CI_SMTP_HOST=""
LOCAL_CI_SMTP_PORT="587"
LOCAL_CI_SMTP_USERNAME=""
LOCAL_CI_SMTP_PASSWORD=""
LOCAL_CI_SMTP_FROM=""
LOCAL_CI_SMTP_TO=""
LOCAL_CI_SMTP_SSL="0"
LOCAL_CI_SMTP_STARTTLS="1"
