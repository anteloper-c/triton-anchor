{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triton-anchor-executions/v1",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "run_id",
    "executions"
  ],
  "properties": {
    "schema": {
      "const": "triton-anchor-executions/v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string"
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "execution_id",
          "tool_id",
          "status",
          "exit_code",
          "artifact_ids"
        ],
        "properties": {
          "execution_id": {
            "type": "string"
          },
          "tool_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
