{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triton-anchor-local-ci/v4",
  "type": "object",
  "required": [
    "schema",
    "task",
    "run_id",
    "status",
    "required_checks",
    "checks",
    "reviews",
    "findings",
    "blockers",
    "performance",
    "unfinished",
    "environment",
    "artifacts",
    "execution_summary_sha256"
  ],
  "properties": {
    "schema": {
      "const": "triton-anchor-local-ci/v4"
    },
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "tested_sha",
        "base_sha",
        "head_sha",
        "worker_revision_sha",
        "metadata_digest"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "infra_error",
        "cancelled"
      ]
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_id",
          "status"
        ],
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "variant": {
            "enum": [
              "base",
              "candidate"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "infra_error",
              "cancelled",
              "not_applicable",
              "not_selected",
              "blocked_dependency"
            ]
          }
        }
      }
    },
    "reviews": {
      "type": "object"
    },
    "findings": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "performance": {
      "type": "array"
    },
    "unfinished": {
      "type": "array"
    },
    "environment": {
      "type": "object"
    },
    "execution_summary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "required"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "execution_id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "omitted": {
            "type": "string"
          }
        },
        "if": {
          "required": [
            "omitted"
          ]
        },
        "then": {
          "properties": {
            "required": {
              "const": false
            }
          }
        },
        "else": {
          "required": [
            "path",
            "sha256",
            "size"
          ]
        }
      }
    }
  }
}
