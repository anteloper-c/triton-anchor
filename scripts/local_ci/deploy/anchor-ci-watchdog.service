[Unit]
Description=Independent Local CI host heartbeat watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=anchor-ci
Group=anchor-ci
WorkingDirectory=/opt/anchor-ci
EnvironmentFile=-/etc/anchor-ci/watchdog.env
ExecStart=/usr/bin/python3 -m scripts.local_ci.maintenance.watchdog --config /etc/anchor-ci/watchdog.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
SuccessExitStatus=1
