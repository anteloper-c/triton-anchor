# EXAMPLE ONLY: regenerate with install.py and actual server configuration.
[Unit]
Description=Validate and rotate persistent Local CI environment
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile="/etc/triton-anchor-local-ci/credentials.env"
WorkingDirectory="/opt/local-ci/control/triton-anchor"
UMask=0077
ExecStart="/usr/bin/python3" "/opt/local-ci/control/triton-anchor/scripts/local_ci/deploy/rotate.py" --config "/etc/triton-anchor-local-ci/config.json" --profile "triton-3.3"
TimeoutStartSec=24h
