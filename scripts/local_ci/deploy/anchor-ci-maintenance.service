[Unit]
Description=Drain and rebuild persistent Local CI workers in trusted UTC windows
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=anchor-ci
Group=anchor-ci
SupplementaryGroups=docker
WorkingDirectory=/opt/anchor-ci
EnvironmentFile=-/etc/anchor-ci/service.env
ExecStart=/usr/bin/python3 -m scripts.local_ci.maintenance --config /etc/anchor-ci/config.json rebuild
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
