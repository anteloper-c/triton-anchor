{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triton-anchor-local-ci-receipt/v4",
  "type": "object",
  "required": ["schema", "task_id", "run_id", "tested_sha", "result_digest", "status", "github_status", "comment", "dashboard"],
  "properties": {
    "schema": {"const": "triton-anchor-local-ci-receipt/v4"},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "tested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "complete"}, "github_status": {"const": true}, "comment": {"const": true}, "dashboard": {"const": true}
  }
}
