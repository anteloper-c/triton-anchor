{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARNING", "FAIL"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^AI-[0-9]{3}$"},
          "severity": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "category": {
            "type": "string",
            "enum": [
              "algorithm",
              "business-logic",
              "state-management",
              "cache-consistency",
              "concurrency",
              "resource-lifecycle",
              "data-integrity",
              "correctness",
              "regression",
              "security",
              "api-compatibility",
              "performance",
              "test-gap",
              "other"
            ]
          },
          "file": {"type": "string"},
          "line": {"type": "string"},
          "title": {"type": "string"},
          "evidence": {"type": "string"},
          "impact": {"type": "string"},
          "fix_direction": {"type": "string"}
        },
        "required": [
          "id",
          "severity",
          "category",
          "file",
          "line",
          "title",
          "evidence",
          "impact",
          "fix_direction"
        ],
        "additionalProperties": false
      }
    },
    "suggested_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^TEST-[0-9]{3}$"},
          "priority": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "target": {"type": "string"},
          "description": {"type": "string"}
        },
        "required": ["id", "priority", "target", "description"],
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "test_execution": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "stable_failure",
            "flaky_failure",
            "infrastructure_failure",
            "test_generation_error",
            "insufficient_evidence"
          ]
        },
        "summary": {"type": "string"},
        "generated_test_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^RUN-[0-9]{3}$"},
              "command": {"type": "string"},
              "exit_code": {"type": "integer"},
              "duration_seconds": {"type": "number", "minimum": 0},
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "stable_failure",
                  "flaky_failure",
                  "infrastructure_failure",
                  "not_executed"
                ]
              },
              "evidence": {"type": "string"}
            },
            "required": [
              "id",
              "command",
              "exit_code",
              "duration_seconds",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "summary", "generated_test_files", "commands"],
      "additionalProperties": false
    },
    "completion_marker": {
      "type": "string",
      "enum": ["CODEX_AI_CI_COMPLETE"]
    }
  },
  "required": [
    "verdict",
    "summary",
    "findings",
    "suggested_tests",
    "residual_risks",
    "test_execution",
    "completion_marker"
  ],
  "additionalProperties": false
}
