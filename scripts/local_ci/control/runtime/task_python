#!/usr/bin/python3 -IS
"""Task Python with immutable startup/tooling and an isolated writable install prefix.

Never process task .pth/sitecustomize/usercustomize. Every Python subprocess spawned
through sys.executable re-enters this root-owned, read-only wrapper.
"""
import os
import importlib.abc
import importlib.machinery
import importlib.util
from pathlib import Path
import runpy
import sys
import sysconfig

WRAPPER = '/opt/anchor-ci/control/runtime/task_python'
venv = Path(os.environ.get('LOCAL_CI_TASK_VENV', ''))
if not venv.is_absolute() or venv.name != 'venv' or not venv.resolve().is_relative_to(Path('/workspace/tasks')):
    raise SystemExit('LOCAL_CI_TASK_VENV must identify the current task venv')
if not (venv / 'pyvenv.cfg').is_file():
    raise SystemExit('Task venv is not initialized')
version = f'python{sys.version_info.major}.{sys.version_info.minor}'
seed = Path('/opt/ci-venv/lib') / version / 'site-packages'
if not seed.is_dir() or seed.stat().st_uid != 0 or seed.stat().st_mode & 0o022:
    raise SystemExit('Immutable seed Python packages are missing or writable')
stdlib = Path(sysconfig.get_path('stdlib'))
# Preserve standard-library paths, never a caller PYTHONPATH, cwd, task site, or
# a task-provided executable. The root seed wins over mutable packaging tools.
sys.path[:] = [str(stdlib), str(stdlib / 'lib-dynload'),
               str(venv / 'lib' / version / 'site-packages'), str(seed)]
# Pin packaging/test infrastructure while allowing installed candidate packages
# to take precedence over older copies in the seed environment.
PROTECTED = {'pip', 'build', 'setuptools', 'wheel', 'packaging', 'pyproject_hooks',
             'pybind11', 'pytest', '_pytest', 'pluggy', 'iniconfig', 'pygments',
             '_distutils_hack', 'distutils', 'tomli', 'colorama'}
class ToolingFinder(importlib.abc.MetaPathFinder):
    def find_spec(self, fullname, path=None, target=None):
        if fullname.split('.')[0] not in PROTECTED:
            return None
        if fullname == 'distutils':
            locations = [str(seed / 'setuptools' / '_distutils')]
            return importlib.util.spec_from_file_location(fullname, str(Path(locations[0]) / '__init__.py'),
                                                         submodule_search_locations=locations)
        locations = [str(seed)] if path is None else list(path)
        if any(not Path(location).resolve().is_relative_to(seed) for location in locations):
            raise ImportError('Tooling package escaped the immutable seed: ' + fullname)
        spec = importlib.machinery.PathFinder.find_spec(fullname, locations)
        if spec is None and path is None:
            raise ImportError('Immutable tooling module is unavailable: ' + fullname)
        # Root-owned tooling also registers virtual submodule finders (six.moves).
        # A validated parent path cannot fall back to writable task packages.
        return spec
sys.meta_path.insert(0, ToolingFinder())
sys.prefix = sys.exec_prefix = str(venv)
sys.executable = WRAPPER
# sysconfig captures prefix constants and default schemes at import time. Reload
# all of them after selecting the task prefix; clearing only _CONFIG_VARS leaves
# some Python versions' initialization flag set and returns None to pip/build.
importlib.reload(sysconfig)
os.environ['PYTHONNOUSERSITE'] = '1'
os.environ['PYTHON_BIN'] = WRAPPER
os.environ['PIP_CONFIG_FILE'] = '/dev/null'
os.environ['PIP_DISABLE_PIP_VERSION_CHECK'] = '1'
for name in ('PIP_TARGET', 'PIP_PREFIX', 'PIP_ROOT', 'PIP_USER'):
    os.environ.pop(name, None)
os.environ.pop('PYTHONPATH', None)
os.environ.pop('PYTHONHOME', None)
args = sys.argv[1:]
while args and args[0].startswith('-') and args[0] not in ('-m', '-c', '-'):
    flag = args.pop(0)
    if flag in ('-I', '-S', '-E', '-s', '-u', '-B'):
        continue
    if flag in ('-W', '-X'):
        if not args:
            raise SystemExit('Python option requires a value')
        args.pop(0)
        continue
    if flag.startswith(('-W', '-X')):
        continue
    if flag in ('--version', '-V'):
        print(sys.version)
        raise SystemExit(0)
    raise SystemExit('Unsupported task Python option: ' + flag)
if not args:
    raise SystemExit('Interactive task Python is disabled')
mode = args.pop(0)
if mode == '-m':
    if not args:
        raise SystemExit('-m needs a module')
    module = args.pop(0)
    sys.argv = [module, *args]
    runpy.run_module(module, run_name='__main__', alter_sys=True)
elif mode == '-c':
    if not args:
        raise SystemExit('-c needs code')
    code = args.pop(0)
    sys.argv = ['-c', *args]
    exec(compile(code, '<string>', 'exec'), {'__name__':'__main__'})
elif mode == '-':
    sys.argv = ['-', *args]
    exec(compile(sys.stdin.read(), '<stdin>', 'exec'), {'__name__':'__main__'})
else:
    script = Path(mode).absolute()
    sys.argv = [str(script), *args]
    # Script-local imports remain available after immutable tooling and stdlib.
    # This does not run .pth files or sitecustomize from its directory.
    sys.path.append(str(script.parent))
    runpy.run_path(str(script), run_name='__main__')
