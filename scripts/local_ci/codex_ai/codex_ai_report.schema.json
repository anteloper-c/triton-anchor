{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARNING", "FAIL"]
    },
    "summary": {
      "type": "string",
      "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"
    },
    "merge_recommendation": {
      "type": "string",
      "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"
    },
    "change_request_assessment": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "partially_implemented",
            "not_implemented",
            "not_assessable",
            "not_applicable"
          ]
        },
        "contributor_goal": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
        "expected_behavior": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
        "implementation_summary": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
        "evidence": {
          "anyOf": [
            {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "description": "Duplicate items are rejected during report validation.",
              "items": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
            }
          ]
        }
      },
      "required": [
        "status",
        "contributor_goal",
        "expected_behavior",
        "implementation_summary",
        "evidence"
      ],
      "additionalProperties": false
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "change_type": {
            "type": "string",
            "enum": ["modified", "added", "deleted", "renamed"]
          },
          "summary": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
          "impact": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
          "validation_strategy": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
        },
        "required": [
          "path",
          "change_type",
          "summary",
          "impact",
          "validation_strategy"
        ],
        "additionalProperties": false
      }
    },
    "behavior_coverage": {
      "type": "object",
      "properties": {
        "normal": {
          "type": "object",
          "properties": {
            "scope": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "strategy": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "result": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "boundary": {
          "type": "object",
          "properties": {
            "scope": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "strategy": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "result": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "error": {
          "type": "object",
          "properties": {
            "scope": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "strategy": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "result": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "scope": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "strategy": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "result": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "integration": {
          "type": "object",
          "properties": {
            "scope": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "strategy": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            "result": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        }
      },
      "required": [
        "normal",
        "boundary",
        "error",
        "compatibility",
        "integration"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^AI-[0-9]{3}$"},
          "severity": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "category": {
            "type": "string",
            "enum": [
              "algorithm",
              "business-logic",
              "state-management",
              "cache-consistency",
              "concurrency",
              "resource-lifecycle",
              "data-integrity",
              "correctness",
              "regression",
              "security",
              "api-compatibility",
              "performance",
              "test-gap",
              "other"
            ]
          },
          "file": {"type": "string"},
          "line": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?:-[1-9][0-9]*)?$"
          },
          "code_role": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
          "title": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
          "evidence": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
          "impact": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
          "fix_direction": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
        },
        "required": [
          "id",
          "severity",
          "category",
          "file",
          "line",
          "code_role",
          "title",
          "evidence",
          "impact",
          "fix_direction"
        ],
        "additionalProperties": false
      }
    },
    "suggested_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^TEST-[0-9]{3}$"},
          "priority": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "target": {"type": "string"},
          "description": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
        },
        "required": ["id", "priority", "target", "description"],
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
    },
    "test_execution": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "stable_failure",
            "flaky_failure",
            "infrastructure_failure",
            "test_generation_error",
            "insufficient_evidence"
          ]
        },
        "summary": {
          "anyOf": [
            {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "description": "Duplicate items are rejected during report validation.",
              "items": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
            }
          ]
        },
        "generated_test_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^RUN-[0-9]{3}$"},
              "command": {"type": "string"},
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"
              },
              "exit_code": {"type": "integer"},
              "duration_seconds": {"type": "number", "minimum": 0},
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "stable_failure",
                  "flaky_failure",
                  "infrastructure_failure",
                  "not_executed"
                ]
              },
              "evidence": {"type": "string", "pattern": ".*[\\u3400-\\u4dbf\\u4e00-\\u9fff].*"}
            },
            "required": [
              "id",
              "command",
              "purpose",
              "exit_code",
              "duration_seconds",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "summary", "generated_test_files", "commands"],
      "additionalProperties": false
    },
    "completion_marker": {
      "type": "string",
      "enum": ["CODEX_AI_CI_COMPLETE"]
    }
  },
  "required": [
    "verdict",
    "summary",
    "merge_recommendation",
    "change_request_assessment",
    "changed_files",
    "behavior_coverage",
    "findings",
    "suggested_tests",
    "residual_risks",
    "test_execution",
    "completion_marker"
  ],
  "additionalProperties": false
}
